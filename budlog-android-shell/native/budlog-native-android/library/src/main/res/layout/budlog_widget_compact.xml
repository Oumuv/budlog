<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/budlog_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_brand_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/budlog_widget_brand_clip"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Budlog"
                android:textColor="@color/budlog_widget_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="尚未同步"
                android:textColor="@color/budlog_widget_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="刷新组件数据"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_normal_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="上次喂奶"
                android:textColor="@color/budlog_widget_primary"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/widget_feeding_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="暂无记录"
                android:textColor="@color/budlog_widget_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_feeding_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="暂无预计时间"
                android:textColor="@color/budlog_widget_muted"
                android:textSize="7sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView android:id="@+id/widget_pee_value" android:layout_width="0dp" android:layout_height="0dp" />
                <TextView android:id="@+id/widget_pee_meta" android:layout_width="0dp" android:layout_height="0dp" />
                <TextView android:id="@+id/widget_poop_value" android:layout_width="0dp" android:layout_height="0dp" />
                <TextView android:id="@+id/widget_poop_meta" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_timer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_timer_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="双侧亲喂中"
                android:textColor="@color/budlog_widget_primary"
                android:textSize="8sp" />

            <Chronometer
                android:id="@+id/widget_timer_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/budlog_widget_text"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/widget_timer_started"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="开始于 00:00"
                android:textColor="@color/budlog_widget_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_state_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="打开 Budlog 完成初始化"
                android:textColor="@color/budlog_widget_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_state_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:text="登录后同步数据"
                android:textColor="@color/budlog_widget_muted"
                android:textSize="7sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_shortcuts"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_shortcut_timer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/budlog_widget_timer_button"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shortcut_timer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text="亲喂"
                android:textColor="@color/budlog_widget_primary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_shortcut_diaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/budlog_widget_diaper_button"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shortcut_diaper" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text="尿便"
                android:textColor="@color/budlog_widget_cyan"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <LinearLayout android:id="@+id/widget_shortcut_bottle" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/widget_shortcut_milk" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/widget_shortcut_task" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
