<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.oumuv.budlog.nativebridge">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:dataExtractionRules="@xml/budlog_data_extraction_rules"
        android:fullBackupContent="@xml/budlog_backup_rules">
        <service
            android:name="dev.oumuv.budlog.nativebridge.BudlogMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="dev.oumuv.budlog.nativebridge.BudlogWidgetRefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="dev.oumuv.budlog.nativebridge.BudlogWidgetProvider"
            android:exported="false"
            android:label="@string/budlog_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budlog_widget_info" />
        </receiver>
    </application>
</manifest>
