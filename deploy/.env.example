# Shared PostgreSQL server credentials
# Use host.docker.internal for PostgreSQL on the macOS host; replace it with a
# routable hostname or IP address when PostgreSQL runs on another machine.
POSTGRESQL_HOST=host.docker.internal
POSTGRESQL_PORT=5432
POSTGRESQL_USER=budlog
POSTGRESQL_PASSWORD=replace-with-a-strong-database-password

# Environment-specific database names
POSTGRESQL_DATABASE=budlog_dev
POSTGRESQL_PROD_DATABASE=budlog

# Required only by the prod Compose configuration
APP_ACCESS_PASSWORD=replace-with-a-family-access-password

# Runtime and published ports
BUDLOG_TIMEZONE=Asia/Shanghai
BUDLOG_FEEDING_INTERVAL_MIN=180
BUDLOG_DEV_WEB_PORT=5174
BUDLOG_PROD_WEB_BIND=127.0.0.1
BUDLOG_PROD_WEB_PORT=5173
BUDLOG_IMAGE_TAG=local
